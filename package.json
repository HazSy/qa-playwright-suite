{
  "name": "qa-playwright-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Suite de pruebas E2E y accesibilidad con Playwright contra OpsDesk y el portfolio público",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=chromium",
    "test:portfolio": "playwright test --project=portfolio",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:3000",
    "install:browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3"
  }
}
